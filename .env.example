
# ⚠️ 이 파일에는 키를 넣지 마세요 (깃헙에 올라가는 예시 파일입니다)
# 이 파일을 복사해 .env 를 만들고, 키는 .env 에 넣으세요:  cp .env.example .env
# 서버는 .env 만 읽습니다. .env 는 .gitignore 에 있어 커밋되지 않습니다

# Google AI Studio (aistudio.google.com) 에서 발급한 본인 키
GEMINI_API_KEY=

# 선택 사항 -----------------------------------------------
# 사용할 모델 (쓸 수 있는 목록: npm run models)
GEMINI_MODEL=gemini-flash-lite-latest
# 생각(thinking) 설정: auto(기본, 빠른 방식을 자동 선택) | default(설정을 보내지 않음) | 숫자(thinkingBudget 고정)
# GEMINI_THINKING=auto
# 응답이 이 시간(ms)보다 느리면 같은 요청을 한 번 더 보내 먼저 오는 쪽을 씁니다. 0 이면 끔
# GEMINI_HEDGE_MS=20000
# 서버 포트
PORT=3000
# 접속 토큰을 고정하고 싶을 때만 (비우면 실행할 때마다 랜덤 생성)
# ACCESS_TOKEN=

# ③ 판매자 보증서 저장소 -------------------------------------
# local(기본): store/ 폴더에 저장 | firestore: Firebase Firestore 에 저장 (npm install firebase-admin 필요)
# STORE=local
# Firestore 를 쓸 때: Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성 → 받은 JSON 경로
# FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
# FIREBASE_PROJECT_ID=
